{
  "name": "rota-acessivel",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:regras": "firebase emulators:exec --only firestore --project demo-rota \"vitest run --config vitest.regras.config.js\"",
    "regras:publicar": "firebase deploy --only firestore:rules,firestore:indexes",
    "coleta:exportar": "node scripts/exportar-coleta.mjs",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-rota",
    "dev:emulador": "vite --mode emulador"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "exceljs": "^4.4.0",
    "firebase": "^13.2.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.64",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
