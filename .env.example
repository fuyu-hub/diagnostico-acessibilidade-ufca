# Configuração do Firebase (Escopo 09). Copie para .env.local e preencha com o
# firebaseConfig do console: Configurações do projeto → Seus apps → app Web.
# Esses valores não são segredo: vão no app publicado. A proteção são as regras do Firestore.
# Sem eles, o app funciona normalmente, só sem as funções de nuvem.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
