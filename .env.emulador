# Modo emulador (npm run dev:emulador): o app usa o Firebase local de `npm run emuladores`,
# com um projeto de demonstração. Nada chega ao projeto real. Não há segredos aqui.
VITE_FIREBASE_EMULADOR=1
VITE_FIREBASE_PROJECT_ID=demo-rota
VITE_FIREBASE_API_KEY=demo-chave
VITE_FIREBASE_AUTH_DOMAIN=demo-rota.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
